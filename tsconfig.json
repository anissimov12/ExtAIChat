{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleDetection": "legacy",
    "rootDir": "src",
    "outDir": "site/js",
    "alwaysStrict": true,
    "strict": false,
    "removeComments": false,
    "sourceMap": true,
    "newLine": "lf",
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
